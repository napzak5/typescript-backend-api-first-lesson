# syntax=docker/dockerfile:1

# One Dockerfile for all three frontend apps. Select the app at build time:
#   docker build -f Dockerfile.frontend --build-arg APP=admin  --build-arg APP_PORT=4001 .
#   docker build -f Dockerfile.frontend --build-arg APP=portal --build-arg APP_PORT=4002 .
#   docker build -f Dockerfile.frontend --build-arg APP=dashboard --build-arg APP_PORT=4003 .
#
# The bundle contains the VITE_* values of one environment. BUILD_SCRIPT selects
# it: build:prod (the default, .env.production) or build:stg (.env.staging).
#   docker build -f Dockerfile.frontend --build-arg APP=admin --build-arg BUILD_SCRIPT=build:stg .

# Keep in sync with .node-version (verified by `pnpm check:versions`).
ARG NODE_VERSION=26.13.1

# Stage 1: Build stage
FROM node:${NODE_VERSION}-alpine AS builder

# admin | portal | dashboard
ARG APP=admin
# build:prod | build:stg
ARG BUILD_SCRIPT=build:prod

# Set working directory
WORKDIR /app

# pnpm version comes from package.json#packageManager
COPY package.json ./
RUN npm install -g "pnpm@$(node -p "require('./package.json').packageManager.split('@')[1]")"

# Copy package files for better caching
COPY pnpm-workspace.yaml pnpm-lock.yaml ./
COPY shared-config/package.json ./shared-config/

# Copy backend packages needed for type generation
COPY backend/packages/api/package.json ./backend/packages/api/
COPY backend/packages/config/package.json ./backend/packages/config/
COPY backend/packages/database/package.json ./backend/packages/database/
COPY backend/packages/domain/package.json ./backend/packages/domain/
COPY backend/packages/generated/package.json ./backend/packages/generated/
COPY backend/packages/infrastructure/package.json ./backend/packages/infrastructure/
COPY backend/packages/utility/package.json ./backend/packages/utility/

# Copy frontend packages
COPY frontend/packages/api-client/package.json ./frontend/packages/api-client/
COPY frontend/packages/assets/package.json ./frontend/packages/assets/
COPY frontend/packages/config/package.json ./frontend/packages/config/
COPY frontend/packages/io/package.json ./frontend/packages/io/
COPY frontend/packages/preferences/package.json ./frontend/packages/preferences/
COPY frontend/packages/session/package.json ./frontend/packages/session/
COPY frontend/packages/testing/package.json ./frontend/packages/testing/
COPY frontend/packages/theme/package.json ./frontend/packages/theme/
COPY frontend/packages/ui/package.json ./frontend/packages/ui/

# Copy the selected app
COPY frontend/apps/${APP}-app/package.json ./frontend/apps/${APP}-app/

# Copy specs
COPY specs/package.json ./specs/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Generate API specifications and types
RUN pnpm generate

# Prepare frontend (generates types for frontend)
RUN pnpm prepare:frontend

# Build the selected app for the selected environment
RUN pnpm --filter "@beauty-salon-frontend/${APP}-app" run "${BUILD_SCRIPT}"

# Stage 2: Production runtime
FROM node:${NODE_VERSION}-alpine AS runtime

ARG APP=admin
ARG APP_PORT=4001
ENV PORT=${APP_PORT}

# Install serve for static file serving
RUN npm install -g serve@14 && npm cache clean --force

# Create app user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S -u 1001 -G nodejs appuser

# Set working directory
WORKDIR /app

# Copy built application from builder stage
COPY --from=builder --chown=appuser:nodejs /app/frontend/apps/${APP}-app/dist/ ./dist/

# Create logs directory
RUN mkdir -p /app/logs && chown appuser:nodejs /app/logs

# Switch to non-root user
USER appuser

EXPOSE ${APP_PORT}

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider "http://localhost:${PORT}/" || exit 1

# Start serve in SPA mode (shell form so that $PORT is expanded)
CMD ["sh", "-c", "exec serve -s dist -l \"${PORT}\""]
