# ================================
# Node Environment
# ================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Reverse proxies in front of the API (0 = clients connect directly)
TRUST_PROXY_HOPS=0

# ================================
# Database Configuration
# ================================
DATABASE_URL=postgres://postgres:postgres@localhost:5432/beauty_salon
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT=30000
POSTGRES_DB=beauty_salon
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DB_HOST=localhost

# ================================
# CORS
# ================================
CORS_ORIGIN=http://localhost:3001,http://localhost:3002,http://localhost:3003
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# ================================
# Rate Limiting
# ================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# ================================
# Mail
# ================================
# SMTP server that carries the mails (locally: Mailpit, http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
# implicit = TLS from the start (465), starttls = upgraded (587), none = plain text (local only)
SMTP_TLS=none
SMTP_USER=mailpit
SMTP_PASSWORD=mailpit
MAIL_FROM=no-reply@beauty-salon.test
# Origin of the web application that the links in mails point at
PUBLIC_APP_URL=http://localhost:3001

# ================================
# Two-Factor Authentication
# ================================
# Key that encrypts the secrets of authenticator apps in the database: 32 characters
# or more, for example from `openssl rand -base64 32`. Do not change it once it is in
# use: no stored secret can be read under another key, so the codes of the apps stop
# working (backup codes still do)
TWO_FACTOR_ENCRYPTION_KEY=local-only-two-factor-encryption-key

# ================================
# Logging
# ================================
LOG_LEVEL=debug
LOG_FORMAT=pretty
