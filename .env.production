# ================================
# Node Environment
# ================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Reverse proxies in front of the API (0 = clients connect directly)
TRUST_PROXY_HOPS=1

# ================================
# Database Configuration
# ================================
DATABASE_URL=postgres://prod_user:prod_password@prod-db-host:5432/beauty_salon_prod
DATABASE_POOL_MAX=50
DATABASE_CONNECTION_TIMEOUT=60000
POSTGRES_DB=beauty_salon_prod
POSTGRES_USER=prod_user
POSTGRES_PASSWORD=prod_password_placeholder
POSTGRES_PORT=5432
DB_HOST=prod-db-host

# ================================
# CORS
# ================================
CORS_ORIGIN=https://beauty-salon.com,https://admin.beauty-salon.com
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# ================================
# Rate Limiting
# ================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ================================
# Mail
# ================================
# SMTP server that carries the mails
SMTP_HOST=prod-smtp-host
SMTP_PORT=587
# implicit = TLS from the start (465), starttls = upgraded (587), none = plain text (local only)
SMTP_TLS=starttls
SMTP_USER=prod_smtp_user_placeholder
SMTP_PASSWORD=prod_smtp_password_placeholder
MAIL_FROM=no-reply@beauty-salon.com
# Origin of the web application that the links in mails point at
PUBLIC_APP_URL=https://beauty-salon.com

# ================================
# Logging
# ================================
LOG_LEVEL=error
LOG_FORMAT=json
