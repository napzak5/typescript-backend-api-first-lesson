{
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@beauty-salon-shared/config": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "exports": {
    ".": {
      "@beauty-salon-frontend/source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vite": {
      "@beauty-salon-frontend/source": "./src/vite.ts",
      "import": "./dist/vite.js",
      "types": "./dist/vite.d.ts"
    }
  },
  "files": [
    "dist",
    "public"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "name": "@beauty-salon-frontend/brand",
  "sideEffects": false,
  "private": true,
  "scripts": {
    "clean": "rm -rf dist *.tsbuildinfo",
    "build:dev": "vite build --mode development",
    "build:test": "vite build --mode test",
    "build:stg": "vite build --mode staging",
    "build:prod": "vite build --mode production",
    "build:watch": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "dev": "vite build --watch --mode development",
    "render": "node scripts/render.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.0.0"
}
