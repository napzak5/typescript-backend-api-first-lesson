{
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "date-fns": "^4.4.0",
    "mrmime": "^2.0.1",
    "nanoid": "^6.0.2",
    "query-string": "^10.0.0",
    "ts-pattern": "^5.9.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@beauty-salon-shared/config": "workspace:*",
    "@biomejs/biome": "^2.6.7",
    "@rslib/core": "^1.0.7",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "jsdom": "^31.0.0",
    "type-fest": "^5.10.0",
    "typescript": "^7.0.2",
    "utility-types": "^3.11.0",
    "vitest": "^5.1.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "name": "@beauty-salon-frontend/utils",
  "version": "0.0.0",
  "sideEffects": false,
  "private": true,
  "scripts": {
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "clean": "rm -rf dist *.tsbuildinfo",
    "build:dev": "NODE_ENV=development rslib build",
    "build:test": "NODE_ENV=test rslib build",
    "build:stg": "NODE_ENV=staging rslib build",
    "build:prod": "NODE_ENV=production rslib build",
    "build:watch": "NODE_ENV=development rslib build --watch",
    "typecheck": "tsc --build",
    "format": "biome format --write .",
    "format:fix": "biome check . --fix --unsafe",
    "dev": "NODE_ENV=development rslib build --watch",
    "dev:tsc": "tsc --build --watch"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
