{
  "name": "@beauty-salon-frontend/api-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist *.tsbuildinfo",
    "build:dev": "NODE_ENV=development rslib build",
    "build:test": "NODE_ENV=test rslib build",
    "build:stg": "NODE_ENV=staging rslib build",
    "build:prod": "NODE_ENV=production rslib build",
    "build:watch": "NODE_ENV=development rslib build --watch",
    "dev": "NODE_ENV=development rslib build --watch",
    "typecheck": "tsc --noEmit",
    "generate": "orval"
  },
  "dependencies": {
    "@beauty-salon-frontend/io": "workspace:*",
    "@tanstack/react-query": "^5.107.1"
  },
  "devDependencies": {
    "@beauty-salon-shared/config": "workspace:*",
    "@rslib/core": "^1.0.7",
    "@types/node": "^26.6.6",
    "orval": "^8.47.0",
    "typescript": "^7.0.2"
  }
}
