{
  "name": "@beauty-salon-frontend/admin-app",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "vite --force --port 3002",
    "build:localhost": "vite build --mode localhost",
    "build:dev": "vite build --mode development",
    "build:test": "vite build --mode test",
    "build:stg": "vite build --mode staging",
    "build:prod": "vite build --mode production",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview --port 3002",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@beauty-salon-frontend/api-client": "workspace:*",
    "@beauty-salon-frontend/brand": "workspace:*",
    "@beauty-salon-frontend/io": "workspace:*",
    "@beauty-salon-frontend/preferences": "workspace:*",
    "@beauty-salon-frontend/salon-screens": "workspace:*",
    "@beauty-salon-frontend/session": "workspace:*",
    "@beauty-salon-frontend/theme": "workspace:*",
    "@beauty-salon-frontend/ui": "workspace:*",
    "@tanstack/react-query": "^5.108.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "ts-pattern": "^5.9.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@beauty-salon-frontend/testing": "workspace:*",
    "@beauty-salon-shared/config": "workspace:*",
    "@storybook/react-vite": "^10.6.7",
    "@tanstack/react-query-devtools": "^5.108.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/ui": "^5.1.0",
    "jsdom": "^31.0.1",
    "rollup-plugin-visualizer": "^7.1.3",
    "storybook": "^10.6.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
