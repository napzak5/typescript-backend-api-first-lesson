{
  "name": "@beauty-salon-frontend/portal-app",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "vite --force --port 3001",
    "build:localhost": "vite build --mode localhost",
    "build:dev": "vite build --mode development",
    "build:test": "vite build --mode test",
    "build:stg": "vite build --mode staging",
    "build:prod": "vite build --mode production",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview --port 3001",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@beauty-salon-frontend/theme": "workspace:*",
    "@beauty-salon-frontend/ui": "workspace:*",
    "@tanstack/react-query": "^5.108.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@beauty-salon-frontend/testing": "workspace:*",
    "@beauty-salon-shared/config": "workspace:*",
    "@tanstack/react-query-devtools": "^5.108.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/ui": "^5.1.0",
    "jsdom": "^31.0.1",
    "rollup-plugin-visualizer": "^7.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
