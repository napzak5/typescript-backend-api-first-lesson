{
  "name": "@beauty-salon/specs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "tsp compile . && node ./scripts/postprocess-openapi.ts",
    "format": "tsp format \"**/*.tsp\"",
    "format:check": "tsp format --check \"**/*.tsp\"",
    "typecheck": "tsc --project scripts/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typespec/compiler": "1.18.0",
    "@typespec/http": "1.18.0",
    "@typespec/openapi": "1.18.0",
    "@typespec/openapi3": "1.18.0",
    "@typespec/rest": "0.88.0",
    "@typespec/versioning": "0.88.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
