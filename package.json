{
  "name": "beauty-salon-reservation-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "dev": "pnpm --filter './frontend/packages/**' run build:dev && pnpm -r --parallel run dev",
    "dev:backend": "pnpm --filter '@beauty-salon-backend/server' run dev",
    "dev:watch:admin-app": "node ./scripts/dev-watch.ts admin-app",
    "dev:watch:portal-app": "node ./scripts/dev-watch.ts portal-app",
    "dev:watch:dashboard-app": "node ./scripts/dev-watch.ts dashboard-app",
    "build": "pnpm build:prod",
    "build:dev": "pnpm -r run build:dev",
    "build:test": "pnpm -r run build:test",
    "build:stg": "pnpm -r run build:stg",
    "build:prod": "pnpm -r run build:prod",
    "build:backend": "pnpm --filter './backend/**' run build:prod",
    "build:frontend": "pnpm --filter './frontend/**' run build:prod",
    "prepare:frontend": "pnpm --filter './frontend/packages/**' run build:prod",
    "start:backend": "pnpm --filter '@beauty-salon-backend/server' run start",
    "preview:frontend": "pnpm --parallel --filter './frontend/apps/**' run preview",
    "test": "pnpm -r run test",
    "test:backend": "pnpm --filter './backend/**' run test",
    "test:frontend": "pnpm --filter './frontend/**' run test",
    "test:integration": "pnpm -r --no-sort run test:integration",
    "test:e2e": "pnpm --filter './frontend/packages/**' run build:prod && pnpm --filter @beauty-salon-frontend/e2e run test:e2e",
    "test:e2e:install": "pnpm --filter @beauty-salon-frontend/e2e run test:e2e:install",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write . && pnpm --filter '@beauty-salon/specs' run format",
    "format:check": "biome format . && pnpm --filter '@beauty-salon/specs' run format:check",
    "format:fix": "biome check --write . && pnpm --filter '@beauty-salon/specs' run format",
    "typecheck": "tsc --project tsconfig.json && pnpm -r run typecheck",
    "clean": "pnpm -r run clean",
    "clean:all": "pnpm -r run clean && pnpm -r exec rm -rf node_modules && rm -rf node_modules",
    "fresh": "pnpm clean:all && pnpm install",
    "prepare": "husky",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "check:versions": "node ./scripts/check-versions.ts",
    "check:generated": "pnpm generate && node ./scripts/check-clean.ts specs/tsp-output backend/packages/generated/src frontend/packages/api-client/src/generated",
    "check:api-db": "pnpm --filter @beauty-salon-backend/database run check:api-consistency",
    "check:db-schema": "pnpm db:fresh && pnpm db:introspect && pnpm db:generate-sql && node ./scripts/check-clean.ts backend/packages/database/src/schema.ts backend/packages/database/src/relations.ts backend/packages/database/sql/setup.sql",
    "update:check": "taze major -r",
    "update:install": "taze major -r -w --install",
    "generate:spec": "pnpm --filter '@beauty-salon/specs' run compile",
    "generate:api": "pnpm --filter '@beauty-salon-frontend/api-client' run generate",
    "generate:backend": "pnpm --filter '@beauty-salon-backend/generated' run generate",
    "generate": "pnpm run generate:spec && pnpm run generate:api && pnpm run generate:backend",
    "generate:watch": "node ./scripts/generate-watch.ts",
    "db:fresh": "pnpm --filter '@beauty-salon-backend/database' run db:fresh",
    "db:migrate": "pnpm --filter '@beauty-salon-backend/database' run db:migrate",
    "db:seed": "pnpm --filter '@beauty-salon-backend/database' run db:seed",
    "db:truncate": "pnpm --filter '@beauty-salon-backend/database' run db:truncate",
    "db:introspect": "pnpm --filter '@beauty-salon-backend/database' run db:introspect",
    "db:generate-sql": "pnpm --filter '@beauty-salon-backend/database' run db:generate-sql"
  },
  "devDependencies": {
    "@beauty-salon-shared/config": "workspace:*",
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "husky": "^9.1.7",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.1",
    "taze": "^21.3.0",
    "typescript": "^7.0.2"
  }
}
