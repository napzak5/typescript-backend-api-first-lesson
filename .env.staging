# ================================
# Node Environment
# ================================
NODE_ENV=staging
PORT=3000
HOST=0.0.0.0
# Reverse proxies in front of the API (0 = clients connect directly)
TRUST_PROXY_HOPS=1

# ================================
# Database Configuration
# ================================
DATABASE_URL=postgres://stg_user:stg_password@stg-db-host:5432/beauty_salon_stg
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT=45000
POSTGRES_DB=beauty_salon_stg
POSTGRES_USER=stg_user
POSTGRES_PASSWORD=stg_password
POSTGRES_PORT=5432
DB_HOST=stg-db-host

# ================================
# CORS
# ================================
CORS_ORIGIN=https://staging.beauty-salon.com,https://admin-staging.beauty-salon.com,https://dashboard-staging.beauty-salon.com
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# ================================
# Rate Limiting
# ================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ================================
# Mail
# ================================
# SMTP server that carries the mails
SMTP_HOST=stg-smtp-host
SMTP_PORT=587
# implicit = TLS from the start (465), starttls = upgraded (587), none = plain text (local only)
SMTP_TLS=starttls
SMTP_USER=stg_smtp_user
SMTP_PASSWORD=stg_smtp_password
MAIL_FROM=no-reply@staging.beauty-salon.com
# Origin of the web application that the links in mails point at
PUBLIC_APP_URL=https://staging.beauty-salon.com

# ================================
# Two-Factor Authentication
# ================================
# Key that encrypts the secrets of authenticator apps in the database: 32 characters
# or more, for example from `openssl rand -base64 32`. Do not change it once it is in
# use: no stored secret can be read under another key, so the codes of the apps stop
# working (backup codes still do)
TWO_FACTOR_ENCRYPTION_KEY=stg_two_factor_encryption_key_of_32_or_more_characters

# ================================
# File Storage
# ================================
# S3-compatible object storage that holds the files of the attachments
STORAGE_ENDPOINT=https://stg-storage-endpoint
# Where a browser reaches the storage: the upload and download URLs name this
# origin. It differs from STORAGE_ENDPOINT only when the server reaches the
# storage by another name, as the backend container of docker compose does
STORAGE_PUBLIC_ENDPOINT=https://stg-storage-endpoint
STORAGE_REGION=stg-storage-region
STORAGE_BUCKET=stg-storage-bucket
STORAGE_ACCESS_KEY_ID=stg_storage_access_key_id_placeholder
STORAGE_SECRET_ACCESS_KEY=stg_storage_secret_access_key_placeholder

# ================================
# Logging
# ================================
LOG_LEVEL=info
LOG_FORMAT=json
