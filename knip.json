{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "taze.config.js"],
      "ignoreDependencies": ["concurrently"]
    },
    "specs": {
      "ignoreDependencies": [
        "@typespec/http",
        "@typespec/openapi",
        "@typespec/openapi3",
        "@typespec/rest",
        "@typespec/versioning"
      ]
    },
    "frontend/packages/ui": {
      "ignoreDependencies": ["@beauty-salon-frontend/theme"]
    }
  }
}
