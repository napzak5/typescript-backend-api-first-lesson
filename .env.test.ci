# Passed to the backend container in the Docker smoke test (docker-validation.yml)
NODE_ENV=test

# Server configuration
PORT=3000
HOST=0.0.0.0
TRUST_PROXY_HOPS=0

# Database (the smoke test passes its own DATABASE_URL)
DATABASE_URL=postgresql://test:test@localhost:5432/test
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT=15000

# CORS configuration
CORS_ORIGIN=http://localhost:3001
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Mail (the smoke test sends none; it runs as production, which refuses
# SMTP_TLS=none and a PUBLIC_APP_URL that is not https)
SMTP_HOST=localhost
SMTP_PORT=587
# implicit = TLS from the start (465), starttls = upgraded (587), none = plain text (local only)
SMTP_TLS=starttls
SMTP_USER=mailpit
SMTP_PASSWORD=mailpit
MAIL_FROM=no-reply@beauty-salon.test
# Origin of the web application that the links in mails point at
PUBLIC_APP_URL=https://app.beauty-salon.test

# Logging
LOG_LEVEL=error
LOG_FORMAT=json
