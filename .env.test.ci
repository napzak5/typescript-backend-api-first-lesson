# Passed to the backend container in the Docker smoke test (docker-validation.yml)
NODE_ENV=test

# Server configuration
PORT=3000
HOST=0.0.0.0
TRUST_PROXY_HOPS=0

# Database (the smoke test passes its own DATABASE_URL)
DATABASE_URL=postgresql://test:test@localhost:5432/test
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT=15000

# CORS configuration
CORS_ORIGIN=http://localhost:3001
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=error
LOG_FORMAT=json
