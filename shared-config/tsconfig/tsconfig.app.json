{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "outDir": "${configDir}/dist",
    "rootDir": "${configDir}/src",
    "tsBuildInfoFile": "${configDir}/dist/tsconfig.tsbuildinfo",
    "noEmit": false
  },
  "include": ["${configDir}/src/**/*"],
  "exclude": [
    "${configDir}/node_modules",
    "${configDir}/dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.integration.test.ts"
  ]
}
