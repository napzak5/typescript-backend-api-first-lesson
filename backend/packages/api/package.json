{
  "name": "@beauty-salon-backend/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@beauty-salon-backend/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist *.tsbuildinfo",
    "build:localhost": "NODE_ENV=localhost rslib build && tsc --emitDeclarationOnly",
    "build:dev": "NODE_ENV=development rslib build && tsc --emitDeclarationOnly",
    "build:test": "NODE_ENV=test rslib build && tsc --emitDeclarationOnly",
    "build:stg": "NODE_ENV=staging rslib build && tsc --emitDeclarationOnly",
    "build:prod": "NODE_ENV=production rslib build && tsc --emitDeclarationOnly",
    "build:watch": "NODE_ENV=development rslib build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@beauty-salon-backend/database": "workspace:*",
    "@beauty-salon-backend/domain": "workspace:*",
    "@beauty-salon-backend/generated": "workspace:*",
    "@beauty-salon-backend/infrastructure": "workspace:*",
    "@beauty-salon-backend/utility": "workspace:*",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "pino-http": "^11.0.0",
    "postgres": "^4.1.1",
    "ts-pattern": "^5.9.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@beauty-salon-shared/config": "workspace:*",
    "@rslib/core": "^1.0.7",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
