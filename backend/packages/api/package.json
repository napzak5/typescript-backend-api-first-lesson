{
  "name": "@beauty-salon-backend/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@beauty-salon-backend/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist *.tsbuildinfo",
    "build:localhost": "vite build --mode localhost",
    "build:dev": "vite build --mode development",
    "build:test": "vite build --mode test",
    "build:stg": "vite build --mode staging",
    "build:prod": "vite build --mode production",
    "build:watch": "vite build --watch --mode development",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:server": "NODE_ENV=test TESTCONTAINERS_RYUK_DISABLED=true DOCKER_CONFIG=/dev/null TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock tsx --conditions=@beauty-salon-backend/source src/__tests__/test-server/main.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@beauty-salon-backend/domain": "workspace:*",
    "@beauty-salon-backend/generated": "workspace:*",
    "@beauty-salon-backend/infrastructure": "workspace:*",
    "@beauty-salon-backend/utility": "workspace:*",
    "@beauty-salon-shared/i18n": "workspace:*",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "pino-http": "^11.0.0",
    "ts-pattern": "^5.9.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@beauty-salon-backend/database": "workspace:*",
    "@beauty-salon-shared/config": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.1",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
