{
  "name": "@beauty-salon-backend/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@beauty-salon-backend/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist *.tsbuildinfo",
    "build:localhost": "vite build --mode localhost",
    "build:dev": "vite build --mode development",
    "build:test": "vite build --mode test",
    "build:stg": "vite build --mode staging",
    "build:prod": "vite build --mode production",
    "build:watch": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check:api-consistency": "tsx --conditions=@beauty-salon-backend/source src/scripts/check-api-consistency.ts",
    "db:migrate": "tsx --conditions=@beauty-salon-backend/source src/scripts/migrate.ts",
    "db:reset": "tsx --conditions=@beauty-salon-backend/source src/scripts/reset-db.ts",
    "db:setup": "tsx --conditions=@beauty-salon-backend/source src/scripts/setup-db.ts",
    "db:introspect": "tsx --conditions=@beauty-salon-backend/source src/scripts/introspect.ts",
    "db:generate-sql": "tsx --conditions=@beauty-salon-backend/source src/scripts/generate-setup-sql.ts",
    "db:fresh": "pnpm db:reset && pnpm db:setup",
    "db:seed": "tsx --conditions=@beauty-salon-backend/source src/scripts/populate-seed.ts",
    "db:truncate": "tsx --conditions=@beauty-salon-backend/source src/scripts/truncate-seed.ts"
  },
  "dependencies": {
    "@beauty-salon-backend/config": "workspace:*",
    "@beauty-salon-backend/utility": "workspace:*",
    "@date-fns/tz": "^1.5.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "@beauty-salon-shared/config": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
