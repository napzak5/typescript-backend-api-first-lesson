{
  "name": "@beauty-salon-backend/domain",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@beauty-salon-backend/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist *.tsbuildinfo",
    "build:localhost": "NODE_ENV=localhost rslib build && tsc --emitDeclarationOnly --project tsconfig.build.json",
    "build:dev": "NODE_ENV=development rslib build && tsc --emitDeclarationOnly --project tsconfig.build.json",
    "build:test": "NODE_ENV=test rslib build && tsc --emitDeclarationOnly --project tsconfig.build.json",
    "build:stg": "NODE_ENV=staging rslib build && tsc --emitDeclarationOnly --project tsconfig.build.json",
    "build:prod": "NODE_ENV=production rslib build && tsc --emitDeclarationOnly --project tsconfig.build.json",
    "build:watch": "NODE_ENV=development rslib build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@beauty-salon-backend/database": "workspace:*",
    "@beauty-salon-backend/generated": "workspace:*",
    "@beauty-salon-backend/utility": "workspace:*",
    "@date-fns/tz": "^1.5.0",
    "date-fns": "^4.4.0",
    "ts-pattern": "^5.9.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@beauty-salon-shared/config": "workspace:*",
    "@rslib/core": "^1.0.7",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
