{
  "name": "@beauty-salon-backend/config",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@beauty-salon-backend/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist *.tsbuildinfo",
    "build:localhost": "vite build --mode localhost",
    "build:dev": "vite build --mode development",
    "build:test": "vite build --mode test",
    "build:stg": "vite build --mode staging",
    "build:prod": "vite build --mode production",
    "build:watch": "vite build --watch --mode development",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@beauty-salon-backend/utility": "workspace:*",
    "dotenv": "^18.0.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@beauty-salon-shared/config": "workspace:*",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
