{
  "name": "@beauty-salon-backend/infrastructure",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@beauty-salon-backend/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist *.tsbuildinfo",
    "build:localhost": "vite build --mode localhost",
    "build:dev": "vite build --mode development",
    "build:test": "vite build --mode test",
    "build:stg": "vite build --mode staging",
    "build:prod": "vite build --mode production",
    "build:watch": "vite build --watch --mode development",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@aws-sdk/s3-request-presigner": "^3.1171.0",
    "@beauty-salon-backend/database": "workspace:*",
    "@beauty-salon-backend/domain": "workspace:*",
    "@beauty-salon-backend/utility": "workspace:*",
    "@beauty-salon-shared/i18n": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "nodemailer": "^10.6.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "postgres": "^4.1.1",
    "ts-pattern": "^5.9.2"
  },
  "devDependencies": {
    "@beauty-salon-backend/testing": "workspace:*",
    "@beauty-salon-shared/config": "workspace:*",
    "@types/node": "^26.6.6",
    "testcontainers": "^12.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
