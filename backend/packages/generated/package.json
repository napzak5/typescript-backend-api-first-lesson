{
  "name": "@beauty-salon-backend/generated",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@beauty-salon-backend/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist *.tsbuildinfo",
    "build:localhost": "NODE_ENV=localhost rslib build",
    "build:dev": "NODE_ENV=development rslib build",
    "build:test": "NODE_ENV=test rslib build",
    "build:stg": "NODE_ENV=staging rslib build",
    "build:prod": "NODE_ENV=production rslib build",
    "build:watch": "NODE_ENV=development rslib build --watch",
    "generate": "tsx scripts/generate-types.ts",
    "typecheck": "tsc --noEmit && tsc --project scripts/tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@beauty-salon-shared/config": "workspace:*",
    "@rslib/core": "^1.0.7",
    "@types/node": "^26.6.6",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "yaml": "^2.9.1"
  }
}
