# ================================
# Node Environment
# ================================
NODE_ENV=localhost
PORT=3000
HOST=0.0.0.0
# Reverse proxies in front of the API (0 = clients connect directly)
TRUST_PROXY_HOPS=0

# ================================
# Database Configuration
# ================================
DATABASE_URL=postgres://postgres:postgres@localhost:5432/beauty_salon
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=30000
DB_HOST=localhost

# For docker-compose
POSTGRES_DB=beauty_salon
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ================================
# CORS Configuration
# ================================
CORS_ORIGIN=http://localhost:3001,http://localhost:3002,http://localhost:3003
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# ================================
# Rate Limiting
# ================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# ================================
# Logging Configuration
# ================================
LOG_LEVEL=debug
LOG_FORMAT=pretty
